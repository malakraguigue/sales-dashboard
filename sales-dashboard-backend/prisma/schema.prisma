generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model sales {
  id             Int      @id @default(autoincrement())
  sale_date      DateTime @db.Date
  product        String   @db.VarChar(255)
  category       Category  
  region         String   @db.VarChar(100)
  quantity       Int
  amount         Decimal  @db.Decimal(10, 2)
  stock_quantity Int?
  companyId String
  company Company @relation(fields: [companyId], references: [id])
}

model sales_alerts {
  id                Int      @id @default(autoincrement())
  alert_date        DateTime @db.Date
  product           String?  @db.VarChar(100)
  region            String?  @db.VarChar(100)
  actual_amount     Decimal? @db.Decimal(12, 2)
  predicted_amount  Decimal? @db.Decimal(12, 2)
  deviation_percent Decimal? @db.Decimal(6, 2)
  severity          String?  @db.VarChar(20)
}

model sales_forecasts {
  id               Int       @id @default(autoincrement())
  forecast_date    DateTime  @db.Date
  product          String?   @db.VarChar(100)
  region           String?   @db.VarChar(100)
  predicted_amount Decimal   @db.Decimal(12, 2)
  lower_bound      Decimal?  @db.Decimal(12, 2)
  upper_bound      Decimal?  @db.Decimal(12, 2)
  model_name       String?   @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
}
enum Category {
  Furniture
  OfficeSupplies @map("Office Supplies")
  Technology
} 
model User{
  id String @id @default(uuid())
  email String @unique
  password String 
  firstName String
  lastName String
  role Role @default(USER)
  isActive  Boolean  @default(true)
  resetToken String?
  resetTokenExpiry DateTime?
  refreshToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  @@map("users")
}
enum Role {
  USER
  ADMIN
  MANAGER
}
model Company{
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  invitations Invitation[]
  users User[]
  sales sales[] 
}
model Invitation{
  id String @id @default(uuid())
  email String
  token String @unique// la preuve que l'invitation est légitime,Avec le token, seule la personne ayant reçu le vrai email (donc le vrai lien) peut accepter.
  rolePropose Role
  companyId String
  company Company  @relation(fields: [companyId], references: [id])
  expiration DateTime
  statutAccepte Boolean @default(false)
}